# ── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-segura-de-50-caracteres
DEBUG=True

# ── Hosts & URLs ─────────────────────────────────────────────────────────────
# En producción: ALLOWED_HOSTS=kurocustom.com,www.kurocustom.com
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:4321
BACKEND_URL=http://localhost:8000

# En producción:
# CORS_ALLOWED_ORIGINS=https://kurocustom.com,https://www.kurocustom.com
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# ── Base de Datos (PostgreSQL) ───────────────────────────────────────────────
DB_NAME=kuro_db
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
# Test keys (pk_test_... / sk_test_...)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# CRÍTICO en producción: obtener desde Stripe Dashboard > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Token de prueba empieza con TEST-, producción con APP_USR-
MERCADOPAGO_ACCESS_TOKEN=TEST-...
# Para verificación de firma en webhooks v2 (recomendado en producción)
# Obtenlo en: MP Dashboard > Tu app > Webhooks > Notification Secret
MERCADOPAGO_WEBHOOK_SECRET=

# ── Skydropx (Envíos) ────────────────────────────────────────────────────────
# Sandbox: sb-pro.skydropx.com | Producción: pro.skydropx.com
SKYDROPX_ENVIRONMENT=sandbox
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
# Para webhook de rastreo (panel Skydropx PRO)
SKYDROPX_WEBHOOK_SECRET=

# ── Email (correos transaccionales) ──────────────────────────────────────────
# En desarrollo: dejar EMAIL_BACKEND vacío → emails se imprimen en consola
# En producción: usar SMTP real (Resend, Gmail, Mailgun, SES, etc.)
#
# === Opción 1: Resend (Recomendado) ===
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxx  # API Key de Resend
# DEFAULT_FROM_EMAIL=Kuro Custom <no-reply@kurocustom.com>
#
# === Opción 2: Gmail ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=correo@kurocustom.com
EMAIL_HOST_PASSWORD=tu_app_password_de_gmail
DEFAULT_FROM_EMAIL=Kuro Custom <no-reply@kurocustom.com>

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# DATOS DE REMITENTE (ORIGEN) PARA SKYDROPX
SKYDROPX_FROM_STREET="Calle"
SKYDROPX_FROM_NAME="Tienda E-commerce"
SKYDROPX_FROM_COMPANY="Mi Empresa SA de CV"
SKYDROPX_FROM_PHONE="0000000000"
SKYDROPX_FROM_EMAIL="contacto@midominio.com"
SKYDROPX_FROM_REF="N/A"