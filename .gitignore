# OS / Editor
.DS_Store
Thumbs.db

.vscode/
.idea/
**/.cursor/

# Env / secrets (keep examples)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example


# Common secret/config files
**/.npmrc
**/*.pem
**/*.key
**/id_rsa
**/id_rsa.pub
**/id_ed25519
**/id_ed25519.pub
**/*kubeconfig*
**/.kube/

# Logs / temp 
**/*.log
**/*.tmp
**/*.swp
**/.cache/

# Node / Astro / Vite 
**/node_modules/
**/dist/
**/.astro/
**/.vercel/
**/coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

#  Python / Django 
**/__pycache__/
**/*.py[cod]
**/*$py.class

**/.venv/
**/venv/

**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Django artifacts
**/db.sqlite3
**/db.sqlite3-journal
**/media/
**/staticfiles/

# Terraform (never commit state)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/.terraform.tfstate.lock.info
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json
