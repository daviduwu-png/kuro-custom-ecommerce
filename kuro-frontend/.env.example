# Frontend (Astro) public env vars
# Nota: variables con prefijo PUBLIC_ quedan expuestas al cliente.

# URL pública del backend para el navegador
PUBLIC_API_URL=http://127.0.0.1:8000/api

# Google OAuth (Client ID) — es público
PUBLIC_GOOGLE_CLIENT_ID=

# Stripe publishable key — es pública (pk_test_... / pk_live_...)
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# (Opcional) Para SSR/containers: backend interno en red Docker/K8s
# API_URL_INTERNAL=http://backend:8000/api
