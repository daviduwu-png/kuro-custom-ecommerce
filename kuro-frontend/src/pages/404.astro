---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Página no encontrada | Kuro Custom">
  <div class="bg-[#0e0e0e] min-h-[75vh] flex items-center justify-center py-20 px-4 border-t border-[#2d2d2d]">
    <div class="max-w-md w-full text-center space-y-6">
      <p class="text-[#888888] text-xs font-mono tracking-[0.3em] uppercase">Error 404</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-widest text-[#f0f0f0] uppercase">
        Pieza No Encontrada
      </h1>
      <p class="text-[#888888] text-sm font-light leading-relaxed">
        El concepto o producto que buscas no existe o ha sido retirado de nuestra bóveda.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/catalogo"
          class="px-8 py-3.5 bg-[#f0f0f0] text-[#0e0e0e] text-xs font-bold uppercase tracking-widest hover:bg-[#d0d0d0] transition-colors"
        >
          Explorar Catálogo
        </a>
        <a
          href="/"
          class="px-8 py-3.5 bg-[#161616] text-[#f0f0f0] text-xs font-bold uppercase tracking-widest border border-[#2d2d2d] hover:border-[#888888] transition-colors"
        >
          Ir al Inicio
        </a>
      </div>
    </div>
  </div>
</Layout>
