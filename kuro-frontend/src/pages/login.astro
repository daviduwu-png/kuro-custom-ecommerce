---
import Layout from "../layouts/Layout.astro";
import GoogleAuth from "../components/GoogleAuth.jsx";
---

<Layout title="Acceso | Kuro Custom">
  <section class="min-h-screen flex items-center justify-center bg-[#0e0e0e] p-4">
    <div
      class="max-w-4xl w-full bg-[#161616] rounded-sm shadow-2xl overflow-hidden flex flex-col md:flex-row border border-[#2d2d2d]"
    >
      <div class="relative w-full h-48 md:h-auto md:w-1/2 bg-[#0e0e0e]">
        <img
          src="https://images.unsplash.com/photo-1550639525-c97d455acf70?auto=format&fit=crop&q=80"
          alt="Noir Fashion"
          class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-30 grayscale"
        />
        <div class="relative z-10 p-6 md:p-10 flex flex-col justify-center h-full text-[#f0f0f0]">
          <h2 class="text-3xl md:text-4xl font-bold mb-2 md:mb-4 uppercase tracking-widest flex items-center gap-3">
            <img src="/kuro-logo.png" alt="Kuro" class="h-8 w-auto opacity-90" />
            Kuro
          </h2>
          <p class="text-[#888888] text-sm md:text-base font-light tracking-wide uppercase">"Identidad materializada."</p>
        </div>
      </div>

      <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center">
        <h3 class="text-xl font-bold text-[#f0f0f0] mb-2 uppercase tracking-widest">Acceso al Sistema</h3>
        <p class="text-[#555555] mb-8 font-light text-sm">Ingresa tus credenciales para continuar.</p>

        <form class="space-y-6" id="loginForm" action="javascript:void(0)" onsubmit="return false">
          <div>
            <label class="block text-xs uppercase tracking-widest text-[#888888] font-bold mb-2">Credencial (Usuario o Email)</label>
            <input
              type="text"
              name="username"
              required
              class="w-full bg-[#1f1f1f] border border-[#2d2d2d] rounded-sm px-4 py-3 text-[#f0f0f0] focus:border-[#555555] focus:ring-1 focus:ring-[#555555] outline-none transition-all placeholder-[#555555]"
              placeholder="tu_usuario"
            />
          </div>
          <div>
            <label class="block text-xs uppercase tracking-widest text-[#888888] font-bold mb-2">Clave de Acceso</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                class="w-full bg-[#1f1f1f] border border-[#2d2d2d] rounded-sm px-4 py-3 pr-10 text-[#f0f0f0] focus:border-[#555555] focus:ring-1 focus:ring-[#555555] outline-none transition-all placeholder-[#555555]"
                placeholder="••••••••"
              />
              <button
                type="button"
                id="togglePassword"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#555555] hover:text-[#f0f0f0] transition-colors"
              >
                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                <svg id="eyeOffIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
              </button>
            </div>
          </div>

          <button
            type="submit"
            class="w-full bg-[#f0f0f0] hover:bg-white text-[#0e0e0e] text-sm uppercase tracking-widest font-bold py-3 rounded-sm transition-all transform active:scale-[0.98]"
            >Autenticar
          </button>
        </form>

        <div class="mt-6 flex items-center justify-center space-x-2">
          <span class="h-px w-full bg-[#2d2d2d]"></span>
          <span class="text-[#555555] font-light text-xs uppercase tracking-widest">O</span>
          <span class="h-px w-full bg-[#2d2d2d]"></span>
        </div>

        <div class="mt-6">
          <GoogleAuth client:load />
        </div>

        <p class="mt-8 text-center text-xs text-[#555555] font-light tracking-wide uppercase">
          ¿No estás registrado? <a href="/registro" class="text-[#f0f0f0] hover:underline font-bold">Solicitar acceso</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { authService } from "../services/authService";
  import { sileo } from "sileo";

  const lightToastOpts = {
    fill: "#161616",
    styles: {
      title: "text-[#f0f0f0] font-bold tracking-widest uppercase text-xs",
      description: "text-[#888888] text-sm font-light",
    },
  };

  function initPasswordToggle() {
    const toggleBtn = document.getElementById("togglePassword");
    const passInput = document.getElementById("password") as HTMLInputElement;
    const eyeIcon = document.getElementById("eyeIcon");
    const eyeOffIcon = document.getElementById("eyeOffIcon");

    if (toggleBtn && passInput) {
      toggleBtn.addEventListener("click", () => {
        const isPassword = passInput.getAttribute("type") === "password";
        passInput.setAttribute("type", isPassword ? "text" : "password");
        if (eyeIcon && eyeOffIcon) {
          eyeIcon.classList.toggle("hidden", isPassword);
          eyeOffIcon.classList.toggle("hidden", !isPassword);
        }
      });
    }
  }

  function initLoginForm() {
    const form = document.getElementById("loginForm") as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        sileo.info({ title: "Autenticando...", ...lightToastOpts });

        const result = await authService.login(data);

        const userName =
          result?.user_name ||
          (localStorage.getItem("user_name") ?? "");
        if (userName) {
          sessionStorage.setItem("show_welcome", userName);
        }

        sileo.success({ title: "Acceso Permitido", description: "Iniciando sesión...", ...lightToastOpts });
        setTimeout(() => { window.location.href = "/"; }, 1200);
      } catch (error: any) {
        if (submitBtn) submitBtn.disabled = false;
        console.error(error);

        const serverDetail = error.response?.data?.detail;
        let mensajeEspañol = "Ocurrió un error inesperado";

        if (serverDetail === "No active account found with the given credentials") {
          mensajeEspañol = "Credenciales incorrectas.";
        } else if (error.response?.status === 401) {
          mensajeEspañol = "Acceso denegado.";
        } else if (error.code === "ERR_NETWORK") {
          mensajeEspañol = "Conexión rechazada. Verifica tu red.";
        }

        sileo.error({ title: "Error de Autenticación", description: mensajeEspañol, ...lightToastOpts });
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initLoginForm();
      initPasswordToggle();
    });
  } else {
    initLoginForm();
    initPasswordToggle();
  }
</script>
