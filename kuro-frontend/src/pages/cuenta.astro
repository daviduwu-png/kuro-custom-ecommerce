---
import Layout from "../layouts/Layout.astro";
import CuentaView from "../components/CuentaView.tsx";
---

<Layout title="Centro de Mando | Kuro Custom">
  <div class="bg-[#0e0e0e] min-h-screen py-10">
    <div class="container mx-auto px-4 max-w-7xl">
      <h1 class="text-2xl font-bold text-[#f0f0f0] mb-8 uppercase tracking-widest border-b border-[#2d2d2d] pb-4">Centro de Mando</h1>
      <div class="relative pt-2">
        <CuentaView client:only="react" />
      </div>
    </div>
  </div>
</Layout>
