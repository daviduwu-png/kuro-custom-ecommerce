---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ProductDetail from "../../components/ProductDetail.jsx";
import { productService } from "../../services/productService";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const product = await productService.getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect("/404");
}
---

<Layout title={`${product.name} | Kuro Custom`}>
  <div class="bg-[#0e0e0e] min-h-screen py-10 md:py-20 border-t border-[#2d2d2d]">
    <div class="container mx-auto px-4 max-w-6xl">
      <nav class="flex text-xs text-[#888888] mb-8 md:mb-12 font-bold uppercase tracking-widest">
        <a href="/" class="hover:text-[#f0f0f0] transition-colors">Inicio</a>
        <span class="mx-3 text-[#2d2d2d]">/</span>
        <a href="/catalogo" class="hover:text-[#f0f0f0] transition-colors">Catálogo</a>
        <span class="mx-3 text-[#2d2d2d]">/</span>
        <span class="text-[#f0f0f0] truncate max-w-[200px]">{product.name}</span>
      </nav>

      <ProductDetail client:load product={product} />
    </div>
  </div>
</Layout>
