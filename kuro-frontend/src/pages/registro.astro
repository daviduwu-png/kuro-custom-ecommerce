---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registro | Kuro Custom">
  <section class="relative min-h-screen flex items-stretch">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1550639525-c97d455acf70?auto=format&fit=crop&q=80"
        class="w-full h-full object-cover opacity-20 grayscale"
        alt="Texture"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[#0e0e0e]/95 via-[#0e0e0e]/80 to-[#0e0e0e]"></div>
    </div>

    <div
      class="relative z-10 w-full md:w-1/2 flex items-center justify-center p-6 bg-transparent md:bg-[#0e0e0e] transition-colors duration-300 border-r border-[#2d2d2d]"
    >
      <div
        class="w-full max-w-md bg-[#161616]/80 md:bg-transparent backdrop-blur-md md:backdrop-blur-none border border-[#2d2d2d] md:border-none rounded-sm p-8 shadow-2xl md:shadow-none"
      >
        <div class="mb-8 text-center md:text-left">
          <h2 class="text-2xl font-bold text-[#f0f0f0] inline-block pb-2 border-b border-[#555555] uppercase tracking-widest flex items-center justify-center md:justify-start gap-3">
             <img src="/kuro-logo.png" alt="Kuro" class="h-6 w-auto opacity-90" />
            Registro Kuro
          </h2>
          <p class="text-[#888888] mt-4 text-xs tracking-wide uppercase font-light">Accede a nuestro ecosistema.</p>
        </div>

        <form class="space-y-5" id="registerForm" action="javascript:void(0)" onsubmit="return false">
          <div class="flex gap-4">
            <div class="w-1/2">
              <label class="block text-[10px] uppercase tracking-widest text-[#888888] font-bold mb-2"> Nombre </label>
              <input
                type="text"
                name="first_name"
                required
                pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+"
                title="Solo se permiten letras y espacios"
                class="w-full bg-[#1f1f1f] border border-[#2d2d2d] rounded-sm px-4 py-3 text-[#f0f0f0] focus:border-[#555555] focus:ring-1 focus:ring-[#555555] outline-none transition-all placeholder-[#555555]"
                placeholder="Nombre"
              />
            </div>

            <div class="w-1/2">
              <label class="block text-[10px] uppercase tracking-widest text-[#888888] font-bold mb-2"> Apellido </label>
              <input
                type="text"
                name="last_name"
                required
                pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+"
                title="Solo se permiten letras y espacios"
                class="w-full bg-[#1f1f1f] border border-[#2d2d2d] rounded-sm px-4 py-3 text-[#f0f0f0] focus:border-[#555555] focus:ring-1 focus:ring-[#555555] outline-none transition-all placeholder-[#555555]"
                placeholder="Apellido"
              />
            </div>
          </div>

          <div>
            <label class="block text-[10px] uppercase tracking-widest text-[#888888] font-bold mb-2">
              Identificador (Usuario)
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              minlength="4"
              pattern="[a-zA-Z0-9_]+"
              title="Mínimo 4 caracteres, solo letras, números y guiones bajos"
              class="w-full bg-[#1f1f1f] border border-[#2d2d2d] rounded-sm px-4 py-3 text-[#f0f0f0] focus:border-[#555555] focus:ring-1 focus:ring-[#555555] outline-none transition-all placeholder-[#555555]"
              placeholder="tu_usuario"
            />
          </div>

          <div>
            <label class="block text-[10px] uppercase tracking-widest text-[#888888] font-bold mb-2">Correo Electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-[#1f1f1f] border border-[#2d2d2d] rounded-sm px-4 py-3 text-[#f0f0f0] focus:border-[#555555] focus:ring-1 focus:ring-[#555555] outline-none transition-all placeholder-[#555555]"
              placeholder="correo@dominio.com"
            />
          </div>

          <div>
            <label class="block text-[10px] uppercase tracking-widest text-[#888888] font-bold mb-2">Clave de Acceso</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="8"
                title="La contraseña debe tener al menos 8 caracteres"
                class="w-full bg-[#1f1f1f] border border-[#2d2d2d] rounded-sm px-4 py-3 pr-10 text-[#f0f0f0] focus:border-[#555555] focus:ring-1 focus:ring-[#555555] outline-none transition-all placeholder-[#555555]"
                placeholder="••••••••"
              />
              <button
                type="button"
                id="togglePassword"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#555555] hover:text-[#f0f0f0] transition-colors"
              >
                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                <svg id="eyeOffIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
              </button>
            </div>
          </div>

          <button
            type="submit"
            class="w-full bg-[#f0f0f0] hover:bg-white text-[#0e0e0e] text-sm uppercase tracking-widest font-bold py-3 rounded-sm transition-all transform active:scale-[0.98] mt-4"
          >
            Solicitar Acceso
          </button>
        </form>

        <p class="mt-8 text-center text-[10px] text-[#555555] uppercase tracking-widest font-light">
          ¿Ya posees credenciales? <a href="/login" class="text-[#f0f0f0] hover:underline font-bold transition">
            Autenticar
          </a>
        </p>
      </div>
    </div>

    <div class="hidden md:block md:w-1/2 relative z-10 bg-[#0e0e0e]">
      <img
        src="https://images.unsplash.com/photo-1550639525-c97d455acf70?auto=format&fit=crop&q=80"
        alt="Noir Fashion"
        class="absolute inset-0 w-full h-full object-cover opacity-40 mix-blend-luminosity grayscale"
      />
      <div class="absolute inset-0 bg-gradient-to-l from-transparent to-[#0e0e0e]"></div>

      <div class="absolute bottom-0 right-0 p-12 text-right z-20">
        <h3 class="text-4xl font-bold text-[#f0f0f0] mb-2 tracking-widest uppercase">Kuro Studio</h3>
        <p class="text-[#888888] text-sm tracking-wide uppercase font-light">Diseño sin compromisos.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { authService } from "../services/authService";
  import { sileo } from "sileo";

  const lightToastOpts = {
    fill: "#161616",
    styles: {
      title: "text-[#f0f0f0] font-bold tracking-widest uppercase text-xs",
      description: "text-[#888888] text-sm font-light",
    },
  };

  function initPasswordToggle() {
    const toggleBtn = document.getElementById("togglePassword");
    const passInput = document.getElementById("password") as HTMLInputElement;
    const eyeIcon = document.getElementById("eyeIcon");
    const eyeOffIcon = document.getElementById("eyeOffIcon");

    if (toggleBtn && passInput) {
      toggleBtn.addEventListener("click", () => {
        const isPassword = passInput.getAttribute("type") === "password";
        passInput.setAttribute("type", isPassword ? "text" : "password");
        if (eyeIcon && eyeOffIcon) {
          eyeIcon.classList.toggle("hidden", isPassword);
          eyeOffIcon.classList.toggle("hidden", !isPassword);
        }
      });
    }
  }

  function initRegisterForm() {
    const form = document.getElementById("registerForm") as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      try {
        sileo.info({ title: "Procesando credenciales...", ...lightToastOpts });
        await authService.register(data);
        sileo.success({ title: "Acceso Concedido", description: "Redirigiendo a autenticación...", ...lightToastOpts });

        setTimeout(() => {
          window.location.href = "/login";
        }, 2000);
      } catch (error: any) {
        if (submitBtn) submitBtn.disabled = false;
        console.error(error);

        let mensajeEspañol = "Ocurrió un error inesperado";
        const errorData = error.response?.data;

        if (error.code === "ERR_NETWORK") {
          mensajeEspañol = "No se pudo conectar con el servidor.";
        } else if (error.response?.status === 400 && errorData) {
          if (errorData.username) {
            mensajeEspañol = "El identificador ya está en uso.";
          } else if (errorData.email) {
            mensajeEspañol = "El correo ya está registrado.";
          } else if (errorData.password) {
            mensajeEspañol = "La clave no cumple con los requisitos mínimos.";
          } else {
            mensajeEspañol = "Datos rechazados. Revisa la información.";
          }
        }

        sileo.error({ title: "Error en el registro", description: mensajeEspañol, ...lightToastOpts });
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initRegisterForm();
      initPasswordToggle();
    });
  } else {
    initRegisterForm();
    initPasswordToggle();
  }
</script>
