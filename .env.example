# Root env for docker-compose (copy to .env)

# Postgres container
POSTGRES_DB=kuro_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django backend DB settings
DB_HOST=db
DB_NAME=kuro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Frontend -> backend (internal Docker network)
API_URL_INTERNAL=http://backend:8000/api
